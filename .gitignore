# ==========================================
# Swami Jap — Comprehensive .gitignore
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
.next/
/out/
/build
/dist
.turbo/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Environment Variables & Secrets (Preserve .env.example template)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example
*.pem
*.key
*.cert
*.crt

# Debug & Execution Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# Databases & Local Data (Prisma / SQLite)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal

# Operating System Files
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Linux
*~
.fuse_hidden*
.directory

# IDE & Editor Configurations
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
*.sublime-project
*.sublime-workspace

# Linters & Tooling Caches
.eslintcache
.stylelintcache
.cache/
.parcel-cache

# Deployment Platforms
.vercel
.netlify

# Temporary Files, Scratch Scripts & Captures
scratch/
temp/
tmp/
*.tmp
*.temp
capture_*.js
capture_*.mjs
test_*.js
test_*.mjs
